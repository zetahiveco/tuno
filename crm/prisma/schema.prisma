generator client {
  provider   = "prisma-client"
  output     = "../generated/client"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
  schemas  = ["crm"]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@schema("crm")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX

  @@schema("crm")
}

enum CustomFieldEntity {
  ACCOUNT
  CONTACT
  TASK

  @@schema("crm")
}

model PipelineStage {
  id          String   @id @default(uuid())
  name        String
  color       String   @default("#755984")
  position    Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  accounts Account[]

  @@index([createdById])
  @@schema("crm")
}

model Account {
  id          String   @id @default(uuid())
  name        String
  email       String   @default("")
  phone       String   @default("")
  source      String   @default("")
  value       Float    @default(0)
  stageId     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stage    PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contacts Contact[]
  tasks    CrmTask[]
  notes    CrmNote[]

  @@index([createdById])
  @@index([stageId])
  @@index([updatedAt])
  @@schema("crm")
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  email       String   @default("")
  phone       String   @default("")
  role        String   @default("")
  accountId   String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tasks   CrmTask[]
  notes   CrmNote[]

  @@index([createdById])
  @@index([accountId])
  @@index([updatedAt])
  @@schema("crm")
}

model CrmTask {
  id          String     @id @default(uuid())
  title       String
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  accountId   String?
  contactId   String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([dueDate])
  @@index([status])
  @@index([accountId])
  @@index([contactId])
  @@schema("crm")
}

model CrmNote {
  id          String   @id @default(uuid())
  body        String   @default("")
  accountId   String?
  contactId   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([accountId])
  @@index([contactId])
  @@schema("crm")
}

model CustomField {
  id          String            @id @default(uuid())
  name        String
  type        CustomFieldType   @default(TEXT)
  options     String            @default("[]")
  appliesTo   CustomFieldEntity
  createdById String
  createdAt   DateTime          @default(now())

  values CustomFieldValue[]

  @@index([appliesTo])
  @@schema("crm")
}

model CustomFieldValue {
  id         String   @id @default(uuid())
  fieldId    String
  entityType String
  entityId   String
  value      String   @default("")

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityType, entityId])
  @@index([entityType, entityId])
  @@schema("crm")
}
