{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./*"]
    },

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "main.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "lib/**/*.ts",
    "general/prisma/prisma.config.ts",
    "mailer/prisma/prisma.config.ts",
    "notes/prisma/prisma.config.ts",
    "forms/prisma/prisma.config.ts",
    "general/**/*.ts",
    "general/**/*.tsx",
    "mailer/**/*.ts",
    "mailer/**/*.tsx",
    "notes/**/*.ts",
    "notes/**/*.tsx",
    "forms/**/*.ts",
    "forms/**/*.tsx",
    "cms/**/*.ts",
    "cms/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "**/generated/**"]
}
