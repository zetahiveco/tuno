{
  "name": "tuno",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun --watch main.ts",
    "start": "bun run build && bun main.ts",
    "build": "bun run build:css && bun run build:client",
    "build:css": "tailwindcss -i ./globals.css -o ./public/assets/app.css",
    "build:client": "bun build ./general/frontend/client.tsx --outdir ./public/assets --target browser",
    "prisma:generate": "bun scripts/database.ts generate",
    "db:push": "bun scripts/database.ts push",
    "db:setup": "bun scripts/database.ts setup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.86",
