    "@base-ui/react": "^1.8.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@blocknote/shadcn": "^0.55.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7",
    "ai": "^7.0.130",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "cookie-parser": "^1.4.7",
