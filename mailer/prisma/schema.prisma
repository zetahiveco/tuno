generator client {
  provider   = "prisma-client"
  output     = "../generated/client"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mailer"]
}

model MailerRecord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@schema("mailer")
}
